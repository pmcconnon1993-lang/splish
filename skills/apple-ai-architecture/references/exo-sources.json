      }
    },
    {
      "id": "exo-prefill",
      "status": "static",
      "claim": "Feature-flagged remote MLX prefill uses TCP; inspected generator finishes prefill before cache writes, client ingests after receipt. QuantizedKVCache/CacheList/DeepseekV4Cache rejected.",
      "limits": "Not evidence of general automatic phase placement, overlapped compute/transfer or cross-runtime state interchange."
    },
    {
      "id": "exo-qwen-chart",
      "status": "documented",
      "claim": "Pinned chart visually read: EXO one/two/four nodes 19.5/26.2/31.9 t/s, giving 1.3436/1.6359 scaling versus EXO single-node.",
